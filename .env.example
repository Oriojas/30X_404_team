# ==============================================================================
# BLINKA PAYAGENT - PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo a .env y define los valores correspondientes
# NUNCA subas el archivo .env al control de versiones
# ==============================================================================

# Backend FastAPI
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# Base de datos PostgreSQL (Railway o Local)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/db_name
# Aplica schema.sql al arrancar (idempotente)
DB_AUTO_MIGRATE=true
# Carga seed.sql con datos FICTICIOS de demostración (TC-01..TC-06). Nunca en producción real.
DB_SEED_DEMO=true

# Bot de Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.up.railway.app/api/webhook/telegram
# Secreto compartido con Telegram (setWebhook secret_token). Sin él el webhook responde 503.
TELEGRAM_WEBHOOK_SECRET=change_me_random_string

# Google Gemini API (OCR y Razonamiento)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Reglas de negocio por defecto (mientras no se lean de company_rules)
COMPANY_ID=BLINKA_DEFAULT
MAX_AUTONOMOUS_USD=2000.00
SARLAFT_CHECK_ENABLED=true
DUPLICATE_CHECK_DAYS=30

# Frontend (React / Vite)
VITE_API_BASE_URL=http://localhost:8000
