# ==============================================================================
# BLINKA PAYAGENT - PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo a .env y define los valores correspondientes
# NUNCA subas el archivo .env al control de versiones
# ==============================================================================

# Backend FastAPI
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Base de datos PostgreSQL (Railway o Local)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/db_name

# Bot de Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.up.railway.app/api/webhook/telegram

# Google Gemini API (OCR y Razonamiento)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend (React / Vite)
VITE_API_BASE_URL=http://localhost:8000
