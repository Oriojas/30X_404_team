server {
    listen ${PORT};
    server_name localhost;

    # Solo sirve el build estático: el dashboard llama al backend por su URL
    # pública (VITE_API_BASE_URL) con CORS, sin proxy.
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
